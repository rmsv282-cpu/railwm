// railbar -- a minimal status bar for railwm.
//
// A full-width override-redirect strip pinned to the top of the screen.
// Without arguments it shows the current date and time; pass a shell
// command as ARGV[1] and it runs that command once a second and shows
// its output instead (anything from a single `date` to a script that
// prints battery / volume / workspace state).
//
// No IPC, no config file, no dependency on railwm itself beyond sharing
// its color palette -- run it standalone or from any WM's startup file.

const std = @import("std");
const c = @cImport({
    @cDefine("_FORTIFY_SOURCE", "0");
    @cInclude("X11/Xlib.h");
    @cInclude("X11/Xutil.h");
    @cInclude("cairo/cairo.h");
    @cInclude("cairo/cairo-xlib.h");
    @cInclude("stdio.h");
    @cInclude("stdlib.h");
    @cInclude("string.h");
    @cInclude("unistd.h");
    @cInclude("time.h");
});

const BAR_HEIGHT = 26;
const MAX_STATUS = 2048;
const REFRESH_MS = 1000; // status is re-queried every second

const STRUT_PARTIAL_LEN = 12;

// Same palette as railwm's own defaults (see wm.zig).
const BG = Color{ .r = 0x0a, .g = 0x14, .b = 0x28 };
const FG = Color{ .r = 0xe8, .g = 0xe8, .b = 0xe0 };
const ACCENT = Color{ .r = 0xff, .g = 0xbf, .b = 0x00 };
const DIM = Color{ .r = 0x4d, .g = 0x38, .b = 0x00 };

const Color = struct {
    r: u8,
    g: u8,
    b: u8,

    fn setSource(self: Color, cr: ?*c.cairo_t) void {
        c.cairo_set_source_rgb(cr,
            @as(f64, @floatFromInt(self.r)) / 255.0,
            @as(f64, @floatFromInt(self.g)) / 255.0,
            @as(f64, @floatFromInt(self.b)) / 255.0);
    }
};

/// Turns a fixed/null-terminated C char buffer into a slice without
/// going through std.mem.sliceTo's generic sentinel-type inference
/// (same trick as raillauncher).
fn cStr(buf: anytype) []const u8 {
    const ptr: [*:0]const u8 = @ptrCast(buf);
    return std.mem.span(ptr);
}

/// Runs `cmd` through `/bin/sh -c`, writes its first MAX_STATUS-1 bytes
/// into `out`, and returns how many bytes were written (trailing
/// newline stripped). A null-failing command yields an empty string.
fn runCommand(out: []u8, cmd: [:0]const u8) usize {
    const fh = c.popen(cmd.ptr, "r");
    if (fh == null) return 0;
    defer _ = c.pclose(fh);

    var total: usize = 0;
    while (total < out.len) {
        const n = c.fread(&out[total], 1, out.len - total, fh);
        if (n == 0) break;
        total += n;
    }
    while (total > 0 and (out[total - 1] == '\n' or out[total - 1] == '\r'))
        total -= 1;
    return total;
}

/// Default status when no command was given: the local date and time.
fn getClock(out: []u8) usize {
    var t: c.time_t = c.time(null);
    const tm = c.localtime(&t);
    if (tm == null) return 0;
    const n = c.strftime(out.ptr, out.len, "%a %b %d  %H:%M:%S", tm);
    return @intCast(n);
}

fn draw(cr: ?*c.cairo_t, width: i32, status: []const u8) void {
    BG.setSource(cr);
    c.cairo_paint(cr);

    c.cairo_select_font_face(cr, "monospace", c.CAIRO_FONT_SLANT_NORMAL, c.CAIRO_FONT_WEIGHT_NORMAL);
    c.cairo_set_font_size(cr, 13);

    FG.setSource(cr);
    c.cairo_move_to(cr, 10, BAR_HEIGHT / 2 + 5);
    const shown = @min(status.len, @as(usize, @intCast(@divTrunc(width, 8))));
    var sbuf: [MAX_STATUS + 1:0]u8 = undefined;
    @memcpy(sbuf[0..shown], status[0..shown]);
    sbuf[shown] = 0;
    c.cairo_show_text(cr, &sbuf);

    // Right edge: a thin accent separator so the bar reads as a frame
    // for the screen rather than a floating block.
    DIM.setSource(cr);
    c.cairo_rectangle(cr, 0, BAR_HEIGHT - 1, width, 1);
    c.cairo_fill(cr);
    ACCENT.setSource(cr);
    c.cairo_rectangle(cr, 0, 0, 2, BAR_HEIGHT);
    c.cairo_fill(cr);

    c.cairo_surface_flush(c.cairo_get_target(cr));
}

pub fn main(init: std.process.Init.Minimal) !void {
    var arena_state = std.heap.ArenaAllocator.init(std.heap.c_allocator);
    defer arena_state.deinit();
    const arena = arena_state.allocator();

    var command: [:0]const u8 = undefined;
    var have_command = false;
    if (init.args.vector.len > 1) {
        const sub = init.args.vector[1];
        command = try arena.dupeZ(u8, std.mem.sliceTo(sub, 0));
        have_command = true;
    }

    const disp = c.XOpenDisplay(null);
    if (disp == null) {
        _ = c.fprintf(c.stderr, "railbar: cannot open X display\n");
        return;
    }
    defer _ = c.XCloseDisplay(disp);

    const screen = c.XDefaultScreen(disp);
    const root = c.XRootWindow(disp, screen);
    const screen_w = c.XDisplayWidth(disp, screen);

    // A full-width strip at the top of the screen, override_redirect so
    // railwm never tiles or hides it.
    var attrs: c.XSetWindowAttributes = std.mem.zeroes(c.XSetWindowAttributes);
    attrs.override_redirect = c.True;
    attrs.background_pixel = 0;
    attrs.event_mask = c.ExposureMask | c.StructureNotifyMask;

    const win = c.XCreateWindow(disp, root, 0, 0,
        @as(c_uint, @intCast(screen_w)), @as(c_uint, @intCast(BAR_HEIGHT)), 0,
        c.CopyFromParent, c.InputOutput, null,
        c.CWOverrideRedirect | c.CWBackPixel | c.CWEventMask, &attrs);

    // Advertise a top strut so railwm (or any WM honoring
    // _NET_WM_STRUT_PARTIAL) keeps tiled windows below the bar --
    // set BEFORE mapping so the WM sees it the moment we appear.
    const strut_atom = c.XInternAtom(disp, "_NET_WM_STRUT_PARTIAL", c.False);
    const dock_atom = c.XInternAtom(disp, "_NET_WM_WINDOW_TYPE_DOCK", c.False);
    const wtype_atom = c.XInternAtom(disp, "_NET_WM_WINDOW_TYPE", c.False);
    // "CARDINAL"/"ATOM" are predefined property types (XA_CARDINAL /
    // XA_ATOM); Xatom.h only ships them as macros, so look them up by
    // name the same way everything else gets interned.
    const cardinal_atom = c.XInternAtom(disp, "CARDINAL", c.False);
    const atom_type = c.XInternAtom(disp, "ATOM", c.False);
    // Values are 32-bit CARDINAL words (format 32); the item types must
    // be u32 or the server re-reads them as 4-byte words and the layout
    // shifts (top would land on index 4 instead of 2).
    var strut: [STRUT_PARTIAL_LEN]u32 = .{
        0, 0, BAR_HEIGHT, 0, // left, right, top, bottom
        0, 0, // left_start_y, left_end_y
        0, 0, // right_start_y, right_end_y
        0, @intCast(screen_w - 1), // top_start_x, top_end_x
        0, 0, // bottom_start_x, bottom_end_x
    };
    _ = c.XChangeProperty(disp, win, strut_atom, cardinal_atom, 32, c.PropModeReplace,
        @ptrCast(&strut), STRUT_PARTIAL_LEN);
    _ = c.XChangeProperty(disp, win, wtype_atom, atom_type, 32, c.PropModeReplace,
        @ptrCast(&dock_atom), 1);

    _ = c.XMapRaised(disp, win);

    const surface = c.cairo_xlib_surface_create(disp, win, c.XDefaultVisual(disp, screen), screen_w, BAR_HEIGHT);
    defer c.cairo_surface_destroy(surface);
    const cr = c.cairo_create(surface);
    defer c.cairo_destroy(cr);

    _ = c.XSelectInput(disp, win, c.ExposureMask | c.StructureNotifyMask);
    _ = c.XFlush(disp);

    var status_buf: [MAX_STATUS]u8 = undefined;
    var status_len: usize = 0;

    while (true) {
        if (have_command) {
            status_len = runCommand(&status_buf, command);
        } else {
            status_len = getClock(&status_buf);
        }
        draw(cr, screen_w, status_buf[0..status_len]);

        // Sleep in 250ms slices so resize/expose events still get
        // noticed promptly; REFRESH_MS is only a target interval.
        var elapsed: i64 = 0;
        while (elapsed < REFRESH_MS) {
            const timeout = REFRESH_MS - @as(i32, @intCast(@min(elapsed, REFRESH_MS)));
            const sleep_us: c_uint = @intCast(@min(@as(i64, 250) * 1000, @as(i64, timeout) * 1000));
            _ = c.usleep(sleep_us);
            elapsed += 250;
            while (c.XPending(disp) > 0) {
                var ev: c.XEvent = undefined;
                _ = c.XNextEvent(disp, &ev);
                if (ev.type == c.Expose)
                    draw(cr, screen_w, status_buf[0..status_len]);
            }
        }
    }
}